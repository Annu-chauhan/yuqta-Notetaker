#!/bin/sh
# Blocks commits that contain an .env file or something that looks like a secret.
# Enable once per clone:  git config core.hooksPath .githooks
# (Bypassing with --no-verify is possible but defeats the purpose; remove the secret instead.)

# Never let a broken output pipe kill the hook: a killed hook would let the commit through.
trap '' PIPE
exec 1>&2  # messages go to stderr

fail=0

# 1. No .env files (the .env.example template is allowed).
envfiles=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -vE '\.env\.example$')
if [ -n "$envfiles" ]; then
  echo "BLOCKED: .env files must never be committed:"
  echo "$envfiles" | sed 's/^/  /'
  echo "  Unstage with:  git restore --staged <file>"
  fail=1
fi

# 2. No well-known secret formats in the added lines.
patterns='sk-or-v1-[A-Za-z0-9]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|GOCSPX-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -vE '^\+\+\+' | grep -nE "$patterns")
if [ -n "$hits" ]; then
  echo "BLOCKED: the staged changes contain what looks like an API key or private key."
  fail=1
fi

# 3. None of the actual values from your local .env files.
for env in $(git ls-files --others --ignored --exclude-standard | grep -E '(^|/)\.env$'); do
  values=$(grep -E '^[A-Z_]*(KEY|SECRET|TOKEN|PASSWORD)[A-Z_]*=.{8,}' "$env" | cut -d= -f2- | tr -d '\r')
  for value in $values; do
    if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -qF -- "$value"; then
      echo "BLOCKED: a value from $env appears in the staged changes."
      fail=1
      break
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo "Commit stopped to protect your secrets."
  exit 1
fi
exit 0
