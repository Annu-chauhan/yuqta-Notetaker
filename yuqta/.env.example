# Copy to .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored. Never commit real keys. Everything works with no keys (mock providers).

APP_ENV=development
LOG_LEVEL=INFO

# Used by the backend. Docker Compose overrides the host to `postgres` automatically.
# When running the backend directly on your machine, use localhost and POSTGRES_HOST_PORT:
#   DATABASE_URL=postgresql://yuqta:yuqta@localhost:5433/yuqta
DATABASE_URL=postgresql://yuqta:yuqta@postgres:5432/yuqta

POSTGRES_USER=yuqta
POSTGRES_PASSWORD=yuqta
POSTGRES_DB=yuqta

# Host ports (change if something else on your machine already uses them).
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# --- Business data ----------------------------------------------------------------------------
# Yuqta always analyzes the meeting itself (summary, decisions, tasks, risks, who spoke). Business data
# (customers, revenue, orders, renewals) is used only when a meeting talks about those customers or revenue.
# true: load the demo customers (Acme, Beta, Gamma) into an empty database on startup.
# false: start without business data; load your own with  python -m app.db.seed  (see README).
DEMO_BUSINESS_DATA=true

# --- Speech-to-text -------------------------------------------------------------------
# mock: returns data/sample_transcript.json.  deepgram: real transcription (needs a key).
STT_PROVIDER=mock
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# en, hi, ... or multi (nova-3: detects the language and follows Hindi/English switching)
STT_LANGUAGE=en
MAX_AUDIO_MB=200

# --- LLM (signal extraction) ----------------------------------------------------------
# openrouter: Jev via OpenRouter (default model).  LLM_API_KEY=sk-or-...  LLM_MODEL=typesafe/jev-router
#             Any other OpenRouter id (vendor/model) with structured outputs also works.
# mock:       deterministic rules, no key (use for offline demos and tests).
# anthropic:  optional, Claude via the Anthropic API; needs LLM_API_KEY=sk-ant-... and a claude-* LLM_MODEL.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=typesafe/jev-router
# Only used with LLM_PROVIDER=anthropic: low | medium | high | xhigh | max
LLM_EFFORT=medium

# --- Google Meet connector --------------------------------------------------------------
# mock: fake Calendar/Meet with demo data.  live: real Google (needs an OAuth client).
GOOGLE_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty to use http://localhost:<BACKEND_HOST_PORT>/auth/google/callback.
# In live mode this exact URL must be an authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=
# Leave empty to use http://localhost:<FRONTEND_HOST_PORT>.
FRONTEND_URL=
# Automatic import of finished meetings (optional; GOOGLE_MODE=live). Google publishes
# "transcript ready" events to this Pub/Sub topic; Yuqta pulls them from the subscription.
#   # Encrypts the stored Google connection so it survives restarts. Empty = reconnect after every restart.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=
GOOGLE_PUBSUB_TOPIC=projects/<project-id>/topics/<topic>
#   GOOGLE_PUBSUB_SUBSCRIPTION=projects/<project-id>/subscriptions/<subscription>
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
AUTO_IMPORT_POLL_SECONDS=15

# --- Live meetings: the Yuqta notetaker bot -------------------------------------------------
# mock:   a simulated bot that "attends" for ~30s and returns the sample meeting (no key).
# recall: Recall.ai sends a real participant into Google Meet / Zoom / Teams calls.
#         Sign up at https://www.recall.ai, create an API key, and set the region your workspace is in.
MEETING_BOT_PROVIDER=mock
RECALL_API_KEY=
RECALL_REGION=us-west-2
# auto = detect the language and follow Hindi/English switching (Hinglish). Or fixed: en, hi, ...
RECALL_LANGUAGE=auto
# Who transcribes: recallai (no setup), deepgram or aws (add that provider's key in the Recall.ai dashboard first).
BOT_TRANSCRIPTION=recallai
# aws: languages to detect and switch between (first = preferred)
AWS_LANGUAGE_OPTIONS=en-IN,hi-IN
BOT_NAME=Yuqta Notetaker
# Posted in the meeting chat when the bot joins (max 500 characters). Leave the line out for the default
# text; an empty value turns the notice off (not recommended: recording people usually needs their consent).
# BOT_CONSENT_MESSAGE=Hi, I'm Yuqta Notetaker. This meeting is being recorded and transcribed to create notes and action items for the team. If you do not want to be recorded, please tell the host now.
BOT_POLL_SECONDS=15

# IANA time zone for the times Yuqta shows (backend messages and the web app), e.g. Asia/Kolkata.
DISPLAY_TIMEZONE=UTC

# --- Calendar auto-join -------------------------------------------------------------------------
# true: Yuqta sends the bot to every Google Meet on the connected Google Calendar (needs GOOGLE_MODE=live
# and "Connect Google" on the Import page; reconnect after a backend restart). Declined and all-day events
# are skipped; moved meetings are rescheduled and deleted ones cancelled.
AUTO_JOIN_CALENDAR=false
AUTO_JOIN_HOURS_AHEAD=24
AUTO_JOIN_POLL_SECONDS=120

# --- Daily task reminder email ----------------------------------------------------------------
# Once a day after REMINDER_HOUR (DISPLAY_TIMEZONE), overdue and due-soon tasks are emailed to REMINDER_TO.
# Off while SMTP_HOST, SMTP_FROM or REMINDER_TO is empty. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com and SMTP_PASSWORD=an app password (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_TO=
REMINDER_HOUR=9

# --- Meeting minutes email (uses the SMTP settings above) ----------------------------------
# off: never sent automatically (a Send button stays on each meeting page).
# review: after each bot-recorded meeting the minutes wait on its page until someone clicks Send.
# auto: sent within minutes of the meeting, except when a recipient is outside your organisation
#       (not in MINUTES_TO and not in INTERNAL_DOMAINS): then it waits for approval.
# Recipients: the calendar event's attendees (calendar auto-join) plus MINUTES_TO.
MINUTES_EMAIL=off
MINUTES_TO=
INTERNAL_DOMAINS=
# The meeting admin gets a separate email with the recording link and the summary: the calendar
# organizer, or the address typed when sending the bot, or else this address.
MEETING_ADMIN_EMAIL=

# --- Authentication -----------------------------------------------------------------------
# All empty = no login (local development only).
# API_AUTH_TOKEN: shared secret between the frontend server and the API.
# APP_PASSWORD:   turns on the login page.  AUTH_SECRET: signs session cookies.
# Generate values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=
APP_PASSWORD=
AUTH_SECRET=
# true when Yuqta is served over HTTPS.
AUTH_COOKIE_SECURE=false
